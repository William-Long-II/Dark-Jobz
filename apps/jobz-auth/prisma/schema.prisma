generator client {
    provider = "prisma-client-js"
    output = "../../../node_modules/@prisma-clients/jobz-auth"
}

datasource db {
    provider = "postgresql"
    url = env("POSTGRES_HOST_URL")
}

model User {
    id         String   @id @default(cuid())
    email      String   @unique
    password   String
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt
}